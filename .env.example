# Database
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DBNAME?schema=public&sslmode=require"

# Auth
AUTH_SECRET="generate-with-npx-auth-secret"
NEXTAUTH_URL="http://localhost:3000"

# App domain routing
NEXT_PUBLIC_SCHEME="https://"
NEXT_PUBLIC_DOMAIN="example.com"
NEXT_PUBLIC_URL="http://localhost:3000/"

# Password reset + invitation emails
RESEND_API_KEY=""
RESEND_FROM_EMAIL="no-reply@example.com"

# Stripe
STRIPE_SECRET_KEY=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""
NEXT_PUBLIC_STRIPE_CLIENT_ID=""
STRIPE_WEBHOOK_SECRET=""
STRIPE_WEBHOOK_SECRET_LIVE=""

# Product + pricing
NEXT_PLURA_PRODUCT_ID=""
NEXT_PUBLIC_PLATFORM_SUBSCRIPTION_PERCENT="0.1"
NEXT_PUBLIC_PLATFORM_ONETIME_FEE="99"
NEXT_PUBLIC_PLATFORM_AGENY_PERCENT="0.1"
